#!/bin/bash

# Import MOS functions
. /usr/local/lib/functions/mos-common

# Set Variables
PLG_NAME="sundtek-driver"
PLG_DIR="/boot/optional/plugins/$PLG_NAME"
SUNDETK_SCRIPT_SRC="$PLG_DIR/sundtek_install.sh"
SUNDETK_SCRIPT="/var/mos/plugins/sundtek-plugins/sundtek_install.sh"
WRAPPER_SCRIPT_SRC="$PLG_DIR/99-sundtekdriverinstall"
WRAPPER_SCRIPT="/var/mos/plugins/sundtek-plugins/99-sundtekdriverinstall"
INSTALL_LOG_DIR="/tmp/sundtek-driver"
SUNDETK_DIR="/tmp/sundtek"
SUNDETK_DEVICES_LIST="$SUNDETK_DIR/devices_list"

# Ensure Sundtek install script is available (download + copy to ext4)
ensure_sundtek_script() {
  # Download if not on /boot
  if [ ! -f "$SUNDETK_SCRIPT_SRC" ]; then
    echo "Downloading Sundtek installation script..."
    mkdir -p "$PLG_DIR"
    if wget -q -O "$SUNDETK_SCRIPT_SRC" "http://sundtek.de/media/sundtek_netinst.sh" 2>/dev/null; then
      sed -i "s/NETINSTALL=1/NETINSTALL=0/g" "$SUNDETK_SCRIPT_SRC"
      echo "Sundtek installation script downloaded and patched"
    else
      echo "Error: Failed to download Sundtek installation script"
      return 1
    fi
  fi

  # Copy to /var/mos/plugins (ext4, supports +x)
  mkdir -p /var/mos/plugins/sundtek-plugins
  cp "$SUNDETK_SCRIPT_SRC" "$SUNDETK_SCRIPT"
  chmod +x "$SUNDETK_SCRIPT"
}

# Copy Sundtek script to container's /config host path
copy_script_to_container() {
  local container="$1"
  local config_path
  config_path=$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/config"}}{{.Source}}{{end}}{{end}}' "$container" 2>/dev/null)

  if [ -z "$config_path" ]; then
    echo "Error: Could not find /config mount for container '$container'"
    return 1
  fi

  cp "$SUNDETK_SCRIPT" "${config_path}/sundtek_install.sh"
  chmod +x "${config_path}/sundtek_install.sh"
  chown 99:100 "${config_path}/sundtek_install.sh" 2>/dev/null || true
  echo "Script copied to $config_path/sundtek_install.sh"
  return 0
}

# Install driver into container (full flow)
install_driver() {
  local container="$1"
  local log_file="$INSTALL_LOG_DIR/${container}.log"
  local status_file="$INSTALL_LOG_DIR/${container}.status"

  mkdir -p "$INSTALL_LOG_DIR"
  echo "" > "$log_file"
  echo "running" > "$status_file"

  (
    echo "=== Sundtek Driver Installation: $container ==="
    echo "Started: $(date)"
    echo ""

    # Step 1: Ensure Sundtek script is available
    echo "[1/3] Checking Sundtek installation script..."
    if ensure_sundtek_script >> "$log_file" 2>&1; then
      echo "      OK"
    else
      echo "      Error: Failed to download Sundtek script"
      echo "failed" > "$status_file"
      exit 1
    fi
    echo ""

    # Step 2: Copy script to container's /config
    echo "[2/3] Copying script to container..."
    # Start container if needed to inspect mounts
    local running
    running=$(docker inspect --format='{{.State.Running}}' "$container" 2>/dev/null)
    if [ "$running" != "true" ]; then
      echo "      Starting container to access mounts..."
      docker start "$container" >> "$log_file" 2>&1
      sleep 2
    fi

    if copy_script_to_container "$container" >> "$log_file" 2>&1; then
      echo "      OK"
    else
      echo "      Error: Failed to copy script to container"
      echo "failed" > "$status_file"
      exit 1
    fi
    echo ""

    # Step 3: Done - frontend will configure container via Socket.IO
    # Container will be recreated and wrapper script will install driver
    echo "[3/3] Ready for container configuration"
    echo "      Container will be configured and restarted automatically"
    echo ""

    echo "=== Preparation completed ==="
    echo "Finished: $(date)"
    echo "success" > "$status_file"
  ) >> "$log_file" 2>&1 &

  local pid=$!
  echo "$pid" > "$INSTALL_LOG_DIR/${container}.pid"
  echo "{\"status\":\"started\"}"
}

# Get install log for a container
get_install_log() {
  local container="$1"
  local log_file="$INSTALL_LOG_DIR/${container}.log"

  if [ -f "$log_file" ]; then
    cat "$log_file"
  else
    echo "No installation log found"
  fi
}

# Get install status for a container
get_install_status() {
  local container="$1"
  local status_file="$INSTALL_LOG_DIR/${container}.status"
  local log_file="$INSTALL_LOG_DIR/${container}.log"

  if [ -f "$status_file" ]; then
    local status
    status=$(cat "$status_file")
    local log_size=0
    if [ -f "$log_file" ]; then
      log_size=$(wc -c < "$log_file")
    fi
    echo "{\"status\":\"$status\",\"log_size\":$log_size}"
  else
    echo "{\"status\":\"none\",\"log_size\":0}"
  fi
}

# Get list of TVHeadend containers
get_tvheadend_containers() {
  local containers
  containers=$(docker ps --all --format '{{json .}}' 2>/dev/null)

  local result="["
  local first=true
  while IFS= read -r line; do
    if [ -z "$line" ]; then continue; fi
    local name
    name=$(echo "$line" | jq -r '.Names[0]' 2>/dev/null | sed 's|^/||')
    local state
    state=$(echo "$line" | jq -r '.State' 2>/dev/null)

    if echo "$name" | grep -qiE 'tvheadend|headend'; then
      if [ "$first" = true ]; then
        first=false
      else
        result="$result,"
      fi
      result="$result{\"name\":\"$name\",\"running\":$([ \"$state\" = \"running\" ] && echo true || echo false)}"
    fi
  done <<< "$containers"
  result="$result]"

  echo "$result"
}

# Update Sundtek install script
update_script() {
  echo "Downloading Sundtek installation script..."
  local tmp_file
  tmp_file=$(mktemp)

  if wget -q -O "$tmp_file" "http://sundtek.de/media/sundtek_netinst.sh" 2>/dev/null; then
    mkdir -p "$PLG_DIR"
    cp "$tmp_file" "$SUNDETK_SCRIPT_SRC"
    sed -i "s/NETINSTALL=1/NETINSTALL=0/g" "$SUNDETK_SCRIPT_SRC"
    mkdir -p /var/mos/plugins/sundtek-plugins
    cp "$SUNDETK_SCRIPT_SRC" "$SUNDETK_SCRIPT"
    chmod +x "$SUNDETK_SCRIPT"
    echo "Sundtek script updated and patched"
    rm -f "$tmp_file"
    return 0
  else
    echo "Failed to download Sundtek script"
    rm -f "$tmp_file"
    return 1
  fi
}

case "$1" in
  containers)
    get_tvheadend_containers
    ;;
  install)
    if [ -z "$2" ]; then
      echo "Error: Container name required"
      exit 1
    fi
    install_driver "$2"
    ;;
  install_log)
    if [ -z "$2" ]; then
      echo "Error: Container name required"
      exit 1
    fi
    get_install_log "$2"
    ;;
  install_status)
    if [ -z "$2" ]; then
      echo "Error: Container name required"
      exit 1
    fi
    get_install_status "$2"
    ;;
  update)
    if [ -z "$2" ]; then
      echo "Error: Container name required"
      exit 1
    fi
    install_driver "$2"
    ;;
  update_script)
    update_script
    ;;
  *)
    echo "Usage: $0 {containers|install <container>|install_log <container>|install_status <container>|update <container>|update_script}"
    exit 1
    ;;
esac
